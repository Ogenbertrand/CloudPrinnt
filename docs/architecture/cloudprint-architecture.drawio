          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="constraints" value="&lt;b&gt;Database invariants:&lt;/b&gt; one unresolved payment attempt per job; unique provider references; unique command IDs;&lt;br&gt;one active device reservation per job; positive copies; nonnegative integer amounts; optimistic job version checks.&lt;br&gt;&lt;b&gt;Tickets:&lt;/b&gt; short human-readable code, unique within the shop's active ticket window. Never a file-access credential.&lt;br&gt;&lt;b&gt;Local SQLite:&lt;/b&gt; job cache, device reservation, print-attempt journal, pending commands, and sync cursor; credentials live in OS secure storage." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#8390a3;fontColor=#17263c;fontSize=12;spacing=7;arcSize=12;shape=text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=0;">
